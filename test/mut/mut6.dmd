-- Passing an element in an array mutably

function addTen(mut x: Int64): None
    x := x + 10

array = [1, 2, 3]
print(array[1])

addTen(mut array[1])
print(array[1])

-- Output
-- program
-- ├──=
-- │  ├──array
-- │  └──[]
-- │     ├──1
-- │     ├──2
-- │     └──3
-- ├──()
-- │  ├──print
-- │  └──[]
-- │     ├──array
-- │     └──1
-- ├──()
-- │  ├──addTen
-- │  └──mut
-- │     └──[]
-- │        ├──array
-- │        └──1
-- ├──()
-- │  ├──print
-- │  └──[]
-- │     ├──array
-- │     └──1
-- └──function addTen(mut x: Int64): None
--    └──:=
--       ├──x
--       └──+
--          ├──x
--          └──10

-- RealOutput
-- 1
-- 11