type Point
    x: Float64
    y: Float64

function addTwo(mut point: Point): None
    point := Point{x: point.x + 2, y: point.y + 2}

point = Point{x: 1, y: 2}
print(point.x)
print(point.y)

addTwo(mut point)
print(point.x)
print(point.y)

