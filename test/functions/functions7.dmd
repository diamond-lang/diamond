function intersects(ball: Ball, paddle: Paddle): Bool
    return
        not ball.x + ball.size < paddle.x 
        or  ball.x > paddle.x + paddle.width
        or  ball.y + ball.size < paddle.y
        or  ball.y > paddle.y + paddle.height

