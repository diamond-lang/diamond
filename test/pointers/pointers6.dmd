-- │     └──y:
-- │        └──&
-- │           └──a
-- ├──=
-- │  ├──*
-- │  │  └──.y
-- │  │     └──p
-- │  └──20
-- ├──()
-- │  ├──print
-- │  └──*
-- │     └──.y
-- │        └──p
-- ├──()
-- │  ├──print
-- │  └──a
-- └──type Point
--    ├──x: Float64
--    └──y: Pointer[Float64]

