-- Passing arrays to generic functions

function printArray(array): None
    i = 1
    while i <= 3
        print(array[i])
        i := i + 1

a = [1, 2, 3]
printArray(a)

-- Output
-- program
-- ├──=
-- │  ├──a
-- │  └──[]
-- │     ├──1
-- │     ├──2
-- │     └──3
-- ├──()
-- │  ├──printArray
-- │  └──a
-- └──function printArray(array): None
--    ├──=
--    │  ├──i
--    │  └──1
--    └──while
--       ├──<=
--       │  ├──i
--       │  └──3
--       ├──()
--       │  ├──print
--       │  └──[]
--       │     ├──array
--       │     └──i
--       └──:=
--          ├──i
--          └──+
--             ├──i
--             └──1

-- RealOutput
-- 1
-- 2
-- 3