-- Returning arrays from generic functions

function getArray(x, y, z)
    return [x, y, z]

a = getArray(10, 20, 30)
print(a[1])
print(a[2])
print(a[3])

-- Output
-- program
-- ├──=
-- │  ├──a
-- │  └──()
-- │     ├──getArray
-- │     ├──10
-- │     ├──20
-- │     └──30
-- ├──()
-- │  ├──print
-- │  └──[]
-- │     ├──a
-- │     └──1
-- ├──()
-- │  ├──print
-- │  └──[]
-- │     ├──a
-- │     └──2
-- ├──()
-- │  ├──print
-- │  └──[]
-- │     ├──a
-- │     └──3
-- └──function getArray(x, y, z)
--    └──return
--       └──[]
--          ├──x
--          ├──y
--          └──z

-- RealOutput
-- 10
-- 20
-- 30