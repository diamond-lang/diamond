-- Arrays with type annotations, but not size
a = [1, 2, 3] : Array[Int64]

print(a[1])
print(a[2])
print(a[3])

-- Output
-- program
-- ├──=
-- │  ├──a
-- │  └──[]: Array[Int64]
-- │     ├──1
-- │     ├──2
-- │     └──3
-- ├──()
-- │  ├──print
-- │  └──[]
-- │     ├──a
-- │     └──1
-- ├──()
-- │  ├──print
-- │  └──[]
-- │     ├──a
-- │     └──2
-- └──()
--    ├──print
--    └──[]
--       ├──a
--       └──3

-- RealOutput
-- 1
-- 2
-- 3