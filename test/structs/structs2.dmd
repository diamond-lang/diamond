-- Field assignment

type Point
    x: Float64
    y: Float64

a = Point{x: 20, y: 30}
a.x = 40
a.y = 50
print(a.x)
print(a.y)

-- Output
-- program
-- ├──=
-- │  ├──a
-- │  └──Point
-- │     ├──x:
-- │     │  └──20
-- │     └──y:
-- │        └──30
-- ├──=
-- │  ├──.x
-- │  │  └──a
-- │  └──40
-- ├──=
-- │  ├──.y
-- │  │  └──a
-- │  └──50
-- ├──()
-- │  ├──print
-- │  └──.x
-- │     └──a
-- ├──()
-- │  ├──print
-- │  └──.y
-- │     └──a
-- └──type Point
--    ├──x: Float64
--    └──y: Float64

-- RealOutput
-- 40
-- 50