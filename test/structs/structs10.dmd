-- Structs in generic functions

type Point
    x: Float64
    y: Float64

type Point3
    x: Float64
    y: Float64
    z: Float64

function generic1(p)
    print(p.x)
    print(p.x)
    print(p.y)

function generic2()
    b = 10.0
    a = Point{x: b + 3.5, y: 10}
    print(a.x)
    print(a.x)
    print(a.y)

generic1(Point{x: 20, y: 30})
generic2()

-- Output
-- program
