-- Printing structs
type Point
    x: Float64
    y: Float64

a = Point{x: 3, y: 10.5}
print(a)

-- Output
-- program
-- ├──=
-- │  ├──a
-- │  └──Point
-- │     ├──x:
-- │     │  └──3
-- │     └──y:
-- │        └──10.5
-- ├──()
-- │  ├──print
-- │  └──a
-- └──type Point
--    ├──x: Float64
--    └──y: Float64

-- RealOutput
-- Point{x: 3, y: 10.5}