-- Passing structs by value

type Point
    x: Float64
    y: Float64

function passingByValue(p: Point): None
    p.x = 10.5
    print(p.x)

p = Point{x: 2, y: 3.5}

passingByValue(p)
print(p.x)

-- Output
-- program
-- ├──=
-- │  ├──p
-- │  └──Point
-- │     ├──x:
-- │     │  └──2
-- │     └──y:
-- │        └──3.5
-- ├──()
-- │  ├──passingByValue
-- │  └──p
-- ├──()
-- │  ├──print
-- │  └──.x
-- │     └──p
-- ├──type Point
-- │  ├──x: Float64
-- │  └──y: Float64
-- └──function passingByValue(p: Point): None
--    ├──=
--    │  ├──.x
--    │  │  └──p
--    │  └──10.5
--    └──()
--       ├──print
--       └──.x
--          └──p

-- RealOutput
-- 10.5
-- 2