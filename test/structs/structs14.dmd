-- Passing structs by value

type Point
    x: Float64
    y: Float64
    z: Float64
    w: Float64

function awesome(point: Point): None
    point.x = 100
    print(point.x)

point = Point{x: 10, y: 10, z: 10, w: 10}
print(point.x)
awesome(point)
print(point.x)

-- Output
-- program
