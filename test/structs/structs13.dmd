-- Copying structs by value

type Point
    x: Float64
    y: Float64

point = Point{x: 2, y: 4}
point2 = point
print(point.x)
point2.x = 66
print(point.x)
print(point2.x)

-- Output
-- program
-- ├──=
-- │  ├──point
-- │  └──Point
-- │     ├──x:
-- │     │  └──2
-- │     └──y:
-- │        └──4
-- ├──=
-- │  ├──point2
-- │  └──point
-- ├──()
-- │  ├──print
-- │  └──.x
-- │     └──point
-- ├──=
-- │  ├──.x
-- │  │  └──point2
-- │  └──66
-- ├──()
-- │  ├──print
-- │  └──.x
-- │     └──point
-- ├──()
-- │  ├──print
-- │  └──.x
-- │     └──point2
-- └──type Point
--    ├──x: Float64
--    └──y: Float64

-- RealOutput
-- 2
-- 2
-- 66