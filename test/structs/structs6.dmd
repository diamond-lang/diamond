-- Passing structs

type Point
    x: Float64
    y: Float64

type Rectangle
    p1: Point
    p2: Point

function printRectangle(rectangle: Rectangle): None
    print(rectangle.p1.x)
    print(rectangle.p1.y)
    print(rectangle.p2.x)
    print(rectangle.p2.y)

rectangle = Rectangle{
    p1: Point{x: 10, y: 10}
    p2: Point{x: 110, y: 60}
}

printRectangle(rectangle)

