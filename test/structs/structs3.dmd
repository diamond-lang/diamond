-- Accesing structs trough identifiers

type Point
    x: Float64
    y: Float64
    z: Float64

a = Point{x: 20, y: 30, z: 40}
b = a

print(b.x)
print(b.y)
print(b.z)

-- Output
-- program
-- ├──=
-- │  ├──a
-- │  └──Point
-- │     ├──x:
-- │     │  └──20
-- │     ├──y:
-- │     │  └──30
-- │     └──z:
-- │        └──40
-- ├──=
-- │  ├──b
-- │  └──a
-- ├──()
-- │  ├──print
-- │  └──.x
-- │     └──b
-- ├──()
-- │  ├──print
-- │  └──.y
-- │     └──b
-- ├──()
-- │  ├──print
-- │  └──.z
-- │     └──b
-- └──type Point
--    ├──x: Float64
--    ├──y: Float64
--    └──z: Float64

-- Output
-- 20
-- 30
-- 40