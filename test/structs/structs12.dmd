-- Field assignment in generic functions

type Point
    x: Float64
    y: Float64

function generic1(p)
    p.x = 50
    p.y = 60
    print(p.x)
    print(p.y)

function generic2()
    b = 10.0
    a = Point{x: b + 3.5, y: 10}
    a.x = b * 10
    a.y = 100
    print(a.x)
    print(a.y)

generic1(Point{x: 20, y: 30})
generic2()

-- Output
-- program
-- ├──()
-- │  ├──generic1
-- │  └──Point
